{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "irodoru",
  "version": "0.1.0",
  "identifier": "io.github.kanade-k-1228.irodoru",
  "build": {
    "beforeDevCommand": "pnpm --filter @irodoru/app dev --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @irodoru/app build",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "irodoru",
        "width": 1200,
        "height": 850,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "devCsp": "default-src 'self'; connect-src http://127.0.0.1:1420 ws://127.0.0.1:1420 ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["iro"],
        "name": "irodoru project",
        "description": "irodoru project",
        "mimeType": "application/x-irodoru-project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.kanade-k-1228.irodoru.project",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/share/mime/packages/irodoru.xml": "linux/irodoru.xml"
        }
      },
      "deb": {
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "shared-mime-info", "desktop-file-utils"],
        "desktopTemplate": "linux/irodoru.desktop",
        "files": {
          "/usr/share/mime/packages/irodoru.xml": "linux/irodoru.xml"
        }
      }
    }
  }
}
